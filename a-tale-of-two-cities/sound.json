    "dover_road": {
      "note": "Shooter's Hill, a Friday night late in November: cold wind and mist on the open road (Dracula's wind, held low). The coach and horses come in as sounds on the words.",
      "levels": {
        "1": 0.6
      }
    },
    "coach_night": {
      "note": "Inside the Dover mail at night: four horses at a labouring trot on mud, every strike a real hoof; the wheels' rumble, leather springs creaking, the wind outside (built for this book).",
      "levels": {
        "1": 0.8
      }
    },
    "dover_inn": {
      "note": "The Royal George at Dover: the coffee-room fire (Dracula's fire)."
    },
    "dover_beach": {
      "note": "Dover beach under the chalk cliffs: the sea thundering on the shingle below a cliff, stones tumbling close by, gulls far off (built for this book)."
    },
    "saint_antoine": {
      "note": "Saint Antoine: a narrow, poor Paris street: wheels and hooves on the stones, people about (A Christmas Carol's street, held well down).",
      "levels": {
        "1": 0.45,
        "2": 0.3
      }
    },
    "wine_shop": {
      "note": "The Defarges' wine-shop: low talk, cups, a small fire (A Christmas Carol's tavern, held down).",
      "levels": {
        "1": 0.5
      }
    },
    "stair": {
      "note": "The courtyard and the long foul staircase: the city far off, nothing near (A Christmas Carol's yard).",
      "levels": {
        "1": 0.7
      }
    },
    "garret": {
